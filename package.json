{
  "name": "agent-courier",
  "version": "0.2.0",
  "description": "Bridge Feishu DMs to a persistent local Codex app-server session.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/bot.mjs",
    "test": "node --test --test-concurrency=1 test/unit/*.test.mjs test/integration/*.test.mjs test/memory/*.test.mjs",
    "test:unit": "node --test --test-concurrency=1 test/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.mjs",
    "test:memory": "node --test --test-concurrency=1 test/memory/*.test.mjs"
  },
  "dependencies": {
    "@larksuite/channel": "0.6.1"
  },
  "overrides": {
    "@larksuiteoapi/node-sdk": "1.76.0"
  }
}
